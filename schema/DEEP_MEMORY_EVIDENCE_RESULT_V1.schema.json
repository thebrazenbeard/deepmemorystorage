{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VERA_DEEP_MEMORY_EVIDENCE_RESULT_V1",
  "title": "Vera Deep Memory historical evidence search result",
  "type": "object",
  "required": ["schema", "query", "privacy_mode", "authorized_privacy_scopes", "count", "results"],
  "properties": {
    "schema": {"const": "VERA_DEEP_MEMORY_EVIDENCE_RESULT_V1"},
    "query": {"type": "string"},
    "privacy_mode": {"enum": ["AUTHORIZED_SCOPE_FILTER", "EXPLICIT_ARCHIVE_AUDIT_ALL"]},
    "authorized_privacy_scopes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "count": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "memory_id",
          "memory_class",
          "stored_historical_canonicity",
          "historical_canonicity",
          "event_time",
          "provenance_ceiling",
          "privacy_scope",
          "currentness_rule",
          "governed_memory_admission",
          "source_ids",
          "ledger_path",
          "overlay_privacy_semantics",
          "result_semantics"
        ],
        "properties": {
          "score": {"type": "integer", "minimum": 0},
          "memory_id": {"type": "string", "minLength": 1},
          "memory_class": {"type": ["string", "null"]},
          "stored_historical_canonicity": {"type": ["string", "null"]},
          "historical_canonicity": {
            "type": ["string", "null"],
            "enum": [
              "CANONICAL_HISTORY",
              "UNRESOLVED_HISTORY",
              "REJECTED_OR_FALSE_ATTRIBUTION",
              "OTHER_IDENTITY_OR_DOMAIN_HISTORY",
              null
            ]
          },
          "event_time": {},
          "observed_event": {},
          "participant_interpretation_at_time": {},
          "later_reevaluation": {},
          "reality_boundary": {},
          "provenance_ceiling": {},
          "privacy_scope": {"type": ["string", "null"]},
          "currentness_rule": {},
          "governed_memory_admission": {},
          "source_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "ledger_path": {"type": "string", "minLength": 1},
          "ledger_line": {"type": "integer", "minimum": 1},
          "historical_canon_overlays": {
            "type": "array",
            "items": {"type": "object"}
          },
          "amendments": {
            "type": "array",
            "items": {"type": "object"}
          },
          "classification_corrections": {
            "type": "array",
            "items": {"type": "object"}
          },
          "overlay_privacy_semantics": {
            "const": "OVERLAY_INHERITS_TARGET_PRIVACY_UNLESS_EXPLICIT_SCOPE_REQUIRES_SEPARATE_AUTHORIZATION"
          },
          "result_semantics": {
            "const": "HISTORICAL_EVIDENCE_ONLY_NOT_CURRENT_MEMORY_OR_AUTHORITY"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
